<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | BT Auto (GarageFlow)</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background-image:
        radial-gradient(at 20% 20%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
        radial-gradient(at 80% 80%, rgba(14, 165, 233, 0.15) 0px, transparent 50%);
    }

    .login-container {
      width: 100%;
      max-width: 460px;
      padding: 15px;
    }

    .login-logo {
      font-size: 2.2rem;
      font-weight: 800;
      background: linear-gradient(135deg, #818CF8, #34D399);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="text-center">
      <div class="login-logo">
        <i class="fa-solid fa-car-burst me-2"></i>GarageFlow
      </div>
    </div>

    <div class="glass-card">
      <div class="text-center mb-3">
        <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-25 text-success rounded-circle mb-2" style="width: 55px; height: 55px;">
          <i class="fa-solid fa-lock-open fa-xl"></i>
        </div>
        <h3 class="text-main font-weight-bold mb-1">ตั้งรหัสผ่านใหม่</h3>
        <p class="text-muted" style="font-size: 0.88rem;">
          ผู้ใช้งาน: <span class="text-info fw-bold"><%= user.fullname %></span> (<%= user.username %>)
        </p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger border-0 text-light bg-danger bg-opacity-25 mb-4" role="alert" style="border-radius: 8px;">
          <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= error %>
        </div>
      <% } %>

      <form action="/auth/reset-password/<%= token %>" method="POST">
        <div class="mb-3">
          <label for="new_password" class="form-label text-light">รหัสผ่านใหม่ (New Password) <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary border-opacity-50 text-muted"><i class="fa-solid fa-lock"></i></span>
            <input type="password" class="form-control form-glass text-light" id="new_password" name="new_password" placeholder="ความยาวอย่างน้อย 6 ตัวอักษร..." required minlength="6">
          </div>
        </div>

        <div class="mb-4">
          <label for="confirm_password" class="form-label text-light">ยืนยันรหัสผ่านใหม่ (Confirm Password) <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary border-opacity-50 text-muted"><i class="fa-solid fa-check-double"></i></span>
            <input type="password" class="form-control form-glass text-light" id="confirm_password" name="confirm_password" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง..." required minlength="6">
          </div>
        </div>

        <button type="submit" class="btn btn-glass-success w-100 py-2.5 font-weight-bold mb-3">
          <i class="fa-solid fa-floppy-disk me-2"></i> บันทึกรหัสผ่านใหม่
        </button>
      </form>

      <div class="text-center pt-2 border-top border-secondary border-opacity-25">
        <a href="/auth/login" class="text-muted text-decoration-none small">
          <i class="fa-solid fa-arrow-left me-1"></i> ยกเลิกและกลับไปหน้าเข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
