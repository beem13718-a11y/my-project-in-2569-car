<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0f172a 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: #f8fafc;
      font-family: 'Prompt', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .kiosk-card {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }
    .clock-display {
      font-size: 3.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: #38bdf8;
      text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
    }
    .qr-container {
      background: #ffffff;
      padding: 16px;
      border-radius: 20px;
      display: inline-block;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(56, 189, 248, 0.2);
    }
    .badge-live {
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.05); }
      100% { opacity: 1; transform: scale(1); }
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-dark px-4 py-3 border-bottom border-secondary border-opacity-25">
    <div class="container-fluid">
      <span class="navbar-brand d-flex align-items-center gap-2 mb-0 h1 fs-4">
        <i class="fa-solid fa-wrench text-primary"></i>
        <span class="fw-bold tracking-wide">BT Auto Service</span>
        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary fs-6 ms-2">Attendance Kiosk</span>
      </span>
      <div class="d-flex align-items-center gap-3">
        <a href="/attendance" class="btn btn-outline-light btn-sm rounded-pill px-3">
          <i class="fa-solid fa-arrow-left me-1"></i> กลับหน้าจัดการ
        </a>
        <button class="btn btn-glass-secondary btn-sm rounded-pill px-3" onclick="toggleFullScreen()">
          <i class="fa-solid fa-expand me-1"></i> เต็มจอ
        </button>
      </div>
    </div>
  </nav>

  <div class="container py-4 my-auto">
    <div class="row align-items-center justify-content-center g-4">

      <div class="col-lg-5 col-md-6 text-center text-md-start">
        <div class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-2 mb-3 badge-live">
          <i class="fa-solid fa-circle me-1 small"></i> ระบบเปิดรับการลงเวลาเข้างาน
        </div>

        <h1 class="display-5 fw-bold mb-2">เช็คชื่อเข้างานประจำวัน</h1>
        <div class="text-muted fs-5 mb-4">
          วันที่ <span class="text-light fw-bold"><%= new Date(today).toLocaleDateString('th-TH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        </div>

        <div class="kiosk-card p-4 mb-4 text-center">
          <div class="text-muted small text-uppercase tracking-wider mb-1">เวลาปัจจุบัน (Current Time)</div>
          <div id="liveClock" class="clock-display font-monospace">00:00:00</div>
          <div class="text-xs text-warning mt-2">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> กำหนดเวลาเข้างานมาตรฐาน: <strong>08:30 น.</strong> (เข้าหลังจากนี้จะบันทึกสถานะ "มาสาย")
          </div>
        </div>

        <div class="d-flex flex-column gap-2 text-muted small">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-circle p-2" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">1</span>
            <span>เปิดกล้องมือถือ หรือเปิดสแกนเนอร์ในแอป <strong>LINE</strong></span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-circle p-2" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">2</span>
            <span>สแกน <strong>QR Code</strong> บนหน้าจอคอมพิวเตอร์นี้</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-circle p-2" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">3</span>
            <span>กดยืนยันชื่อช่างเพื่อบันทึกเวลาเข้างานทันที</span>
          </div>
        </div>
      </div>

      <div class="col-lg-5 col-md-6 text-center">
        <div class="kiosk-card p-5">
          <div class="text-muted small mb-3">
            <i class="fa-solid fa-qrcode text-info me-1"></i> สแกนเพื่อยืนยันตัวตนเข้างาน (สุ่มรหัสใหม่ทุกวัน)
          </div>

          <div class="qr-container mb-3 position-relative">
            <img id="qrImageDisplay" src="<%= qrDataUrl %>" alt="Daily Attendance QR Code" class="img-fluid rounded" style="width: 280px; height: 280px;">
            <div id="qrRefreshOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center bg-dark bg-opacity-75 rounded">
              <div class="spinner-border text-info" role="status"></div>
            </div>
          </div>

          <div class="mb-3 px-3">
            <div class="d-flex justify-content-between align-items-center text-xs text-muted mb-1">
              <span><i class="fa-solid fa-arrows-rotate me-1 text-info"></i> รีเฟรช QR อัตโนมัติใน:</span>
              <span class="font-monospace fw-bold text-info"><span id="countdownDisplay">60</span> วินาที</span>
            </div>
            <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
              <div id="countdownProgressBar" class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%;"></div>
            </div>
          </div>

          <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
            <div class="text-xs text-muted font-monospace">
              TOKEN: <span id="tokenDisplay" class="text-info fw-bold"><%= token %></span>
            </div>
            <button type="button" id="btnManualRefresh" class="btn btn-glass-secondary btn-sm rounded-pill px-2 py-0 text-xs" title="รีเฟรช QR ทันที">
              <i class="fa-solid fa-rotate me-1"></i> รีเฟรชทันที
            </button>
          </div>

          <div class="alert alert-secondary py-2 px-3 small border-0 bg-secondary bg-opacity-10 text-muted rounded-pill mb-0">
            <i class="fa-solid fa-shield-halved text-success me-1"></i> ความปลอดภัยสูง: QR Code สุ่มใหม่ทุก 1 นาที ป้องกันการส่งต่อภาพข้ามวัน
          </div>
        </div>
      </div>

    </div>

    <div class="kiosk-card p-4 mt-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 text-light">
          <i class="fa-solid fa-clipboard-check text-success me-2"></i>ช่างที่ลงเวลาเข้างานแล้ววันนี้
          (<span id="checkedCountDisplay"><%= todayRows.length %></span> คน)
        </h6>
        <span class="badge bg-secondary bg-opacity-25 text-muted small">อัปเดตเรียลไทม์</span>
      </div>

      <div id="checkedStaffContainer" class="d-flex flex-wrap gap-2">
        <% if (todayRows.length === 0) { %>
          <div class="text-center text-muted py-3 small w-100" id="emptyNotice">
            <i class="fa-solid fa-hourglass-start me-1"></i> ยังไม่มีช่างลงเวลาเข้างานในวันนี้ สแกน QR Code ด้านบนเพื่อเริ่มลงเวลา
          </div>
        <% } else { %>
          <% todayRows.forEach(row => {
               const isLate = row.status === 'late';
               const timeStr = new Date(row.clock_in).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
          %>
            <div class="badge <%= isLate ? 'bg-warning text-dark' : 'bg-success text-white' %> px-3 py-2 rounded-pill d-flex align-items-center gap-2 shadow-sm">
              <i class="fa-solid <%= isLate ? 'fa-triangle-exclamation' : 'fa-check' %>"></i>
              <span class="fw-bold"><%= row.fullname %></span>
              <span class="font-monospace small">(<%= timeStr %> น.)</span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <footer class="text-center py-3 text-muted small border-top border-secondary border-opacity-25">
    ระบบจัดการอู่ซ่อมรถยนต์ (Automotive Workshop Management System) • BT Auto Service
  </footer>

  <script>
    function updateClock() {
      const now = new Date();
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const seconds = String(now.getSeconds()).padStart(2, '0');
      document.getElementById('liveClock').textContent = `${hours}:${minutes}:${seconds}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    const TOTAL_SECONDS = 60;
    let secondsLeft = TOTAL_SECONDS;
    const countdownEl = document.getElementById('countdownDisplay');
    const progressBar = document.getElementById('countdownProgressBar');
    const qrImg = document.getElementById('qrImageDisplay');
    const tokenEl = document.getElementById('tokenDisplay');
    const qrOverlay = document.getElementById('qrRefreshOverlay');
    const countDisplay = document.getElementById('checkedCountDisplay');
    const staffContainer = document.getElementById('checkedStaffContainer');

    function fetchNewQrCode() {
      if (qrOverlay) qrOverlay.classList.remove('d-none');
      qrOverlay.classList.add('d-flex');

      fetch('/attendance/qr-api')
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            qrImg.src = data.qrDataUrl;
            tokenEl.textContent = data.token;
            countDisplay.textContent = data.checkedCount;

            if (data.todayRows && data.todayRows.length > 0) {
              let badgesHtml = '';
              data.todayRows.forEach(row => {
                const isLate = row.status === 'late';
                const timeStr = new Date(row.clock_in).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                badgesHtml += `
                  <div class="badge ${isLate ? 'bg-warning text-dark' : 'bg-success text-white'} px-3 py-2 rounded-pill d-flex align-items-center gap-2 shadow-sm">
                    <i class="fa-solid ${isLate ? 'fa-triangle-exclamation' : 'fa-check'}"></i>
                    <span class="fw-bold">${row.fullname}</span>
                    <span class="font-monospace small">(${timeStr} น.)</span>
                  </div>
                `;
              });
              staffContainer.innerHTML = badgesHtml;
            }
          }
        })
        .catch(err => console.error('Failed to refresh QR:', err))
        .finally(() => {
          if (qrOverlay) {
            qrOverlay.classList.remove('d-flex');
            qrOverlay.classList.add('d-none');
          }
          secondsLeft = TOTAL_SECONDS;
          updateProgressBar();
        });
    }

    function updateProgressBar() {
      countdownEl.textContent = secondsLeft;
      const percent = (secondsLeft / TOTAL_SECONDS) * 100;
      progressBar.style.width = percent + '%';

      if (secondsLeft <= 10) {
        progressBar.className = 'progress-bar bg-danger progress-bar-striped progress-bar-animated';
      } else if (secondsLeft <= 25) {
        progressBar.className = 'progress-bar bg-warning progress-bar-striped progress-bar-animated';
      } else {
        progressBar.className = 'progress-bar bg-info progress-bar-striped progress-bar-animated';
      }
    }

    setInterval(() => {
      secondsLeft--;
      if (secondsLeft <= 0) {
        fetchNewQrCode();
      } else {
        updateProgressBar();
      }
    }, 1000);

    document.getElementById('btnManualRefresh').addEventListener('click', function() {
      fetchNewQrCode();
    });

    function toggleFullScreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }
  </script>
</body>
</html>
