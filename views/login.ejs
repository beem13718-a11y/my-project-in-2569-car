<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | อู่สมาร์ทการาจ (SmartGarage)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Prompt', 'Segoe UI', Tahoma, sans-serif;
    }
    body {
      min-height: 100vh;
      margin: 0;
      display: flex;
      flex-direction: column;
      background-color: #090d16;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.14) 0%, transparent 45%),
        radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.1) 0%, transparent 45%);
      color: #e2e8f0;
    }
    .garage-top-strip {
      background: #05080f;
      border-bottom: 1px solid #1e293b;
      font-size: 0.84rem;
      color: #94a3b8;
      padding: 7px 0;
    }
    .top-strip-inner {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .garage-taskbar {
      position: sticky;
      top: 0;
      z-index: 1050;
      background: rgba(11, 17, 32, 0.96);
      backdrop-filter: blur(12px);
      border-bottom: 2px solid #0ea5e9;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.65);
      padding: 12px 0;
    }
    .taskbar-container {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }
    .brand-crest {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      border: 2px solid #38bdf8;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 16px rgba(14, 165, 233, 0.35);
    }
    .brand-name-th {
      font-size: 1.28rem;
      font-weight: 800;
      color: #f8fafc;
      line-height: 1.15;
    }
    .brand-name-sub {
      font-size: 0.78rem;
      color: #38bdf8;
      font-weight: 600;
    }
    .taskbar-nav {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .taskbar-link {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.98rem;
      font-weight: 600;
      padding: 8px 15px;
      border-radius: 10px;
      transition: all 0.15s ease;
    }
    .taskbar-link:hover {
      background: rgba(14, 165, 233, 0.15);
      color: #38bdf8;
    }
    .taskbar-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-task-track {
      background: linear-gradient(135deg, #059669, #10b981);
      color: #ffffff;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 9px 16px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid #34d399;
    }
    .btn-task-login {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      color: #ffffff;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 9px 16px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid #38bdf8;
    }
    .login-main-area {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 20px;
    }
    .login-box {
      width: 100%;
      max-width: 440px;
      background: #111827;
      border: 1px solid #1e293b;
      border-top: 5px solid #0ea5e9;
      border-radius: 20px;
      padding: 34px 32px 28px 32px;
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.65);
    }
    .logo-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 22px;
    }
    .logo-svg-badge {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      background: #0b1120;
      border: 2px solid #38bdf8;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(14, 165, 233, 0.3);
      margin-bottom: 12px;
    }
    .app-title {
      font-size: 1.48rem;
      font-weight: 800;
      color: #f8fafc;
      margin: 0;
    }
    .app-subtitle {
      font-size: 0.92rem;
      color: #94a3b8;
      margin-top: 4px;
      font-weight: 500;
    }
    .field-label {
      font-size: 0.96rem;
      font-weight: 600;
      color: #e2e8f0;
      margin-bottom: 6px;
      display: block;
    }
    .input-group-friendly {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-icon-left {
      position: absolute;
      left: 15px;
      color: #38bdf8;
      font-size: 1.05rem;
      pointer-events: none;
    }
    .friendly-input {
      width: 100%;
      height: 50px;
      padding: 10px 44px;
      font-size: 1rem;
      color: #f8fafc;
      background: #090d16;
      border: 2px solid #334155;
      border-radius: 12px;
      transition: all 0.2s ease;
    }
    .friendly-input::placeholder {
      color: #64748b;
    }
    .friendly-input:focus {
      outline: none;
      background: #090d16;
      border-color: #38bdf8;
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
      color: #ffffff;
    }
    .toggle-pw-btn {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 1.05rem;
      padding: 6px;
      cursor: pointer;
    }
    .forgot-link {
      font-size: 0.9rem;
      font-weight: 600;
      color: #38bdf8;
      text-decoration: none;
    }
    .forgot-link:hover {
      text-decoration: underline;
    }
    .btn-login-main {
      width: 100%;
      height: 52px;
      border: 1px solid #38bdf8;
      border-radius: 12px;
      background: linear-gradient(135deg, #0284c7, #2563eb);
      color: #ffffff;
      font-size: 1.08rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 8px 18px rgba(14, 165, 233, 0.3);
    }
    .btn-login-main:hover {
      background: linear-gradient(135deg, #0369a1, #1d4ed8);
    }
  </style>
</head>
<body>

  <div class="garage-top-strip">
    <div class="top-strip-inner">
      <div>
        <i class="fa-solid fa-wrench text-info me-1"></i>
        <b>ศูนย์ซ่อมบำรุงรถยนต์ครบวงจร:</b> เครื่องยนต์ • เกียร์ • ช่วงล่าง • เบรก • แอร์ • วิเคราะห์ระบบไฟ OBD-II
      </div>
      <div class="d-flex gap-4 flex-wrap">
        <span><i class="fa-solid fa-clock text-success me-1"></i> จันทร์ - เสาร์ 08:00 - 18:00 น.</span>
        <span><i class="fa-solid fa-phone text-info me-1"></i> สายด่วนช่างใหญ่: <b class="text-light">081-234-5678</b></span>
      </div>
    </div>
  </div>

  <header class="garage-taskbar">
    <div class="taskbar-container">
      <a href="/" class="brand-link">
        <div class="brand-crest">
          <svg width="34" height="34" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 36L20 22H44L50 36H14Z" stroke="#38BDF8" stroke-width="3" fill="rgba(56,189,248,0.15)"/>
            <rect x="10" y="35" width="44" height="11" rx="4" fill="#38BDF8"/>
            <circle cx="20" cy="46" r="5" fill="#090D16" stroke="#E2E8F0" stroke-width="3"/>
            <circle cx="44" cy="46" r="5" fill="#090D16" stroke="#E2E8F0" stroke-width="3"/>
            <path d="M8 54H56" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>
            <path d="M18 54V59M46 54V59" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="brand-name-th">อู่สมาร์ทการาจ (SmartGarage)</div>
          <div class="brand-name-sub"><i class="fa-solid fa-gears me-1"></i>AUTO REPAIR &amp; SERVICE CENTER</div>
        </div>
      </a>

      <div class="taskbar-actions">
        <a href="/public/track" class="btn-task-track">
          <i class="fa-solid fa-car-side"></i>
          <span>เช็กสถานะรถลูกค้า</span>
        </a>
        <a href="/auth/login" class="btn-task-login">
          <i class="fa-solid fa-user-gear"></i>
          <span>เข้าสู่ระบบพนักงาน</span>
        </a>
      </div>

      <nav class="taskbar-nav">
        <a href="/#hero" class="taskbar-link"><i class="fa-solid fa-warehouse me-1"></i> หน้าแรกอู่</a>
        <a href="/#services" class="taskbar-link"><i class="fa-solid fa-screwdriver-wrench me-1"></i> งานบริการซ่อม</a>
        <a href="/#reviews" class="taskbar-link"><i class="fa-solid fa-star me-1"></i> รีวิวจากลูกค้า</a>
        <a href="/#contact" class="taskbar-link"><i class="fa-solid fa-location-dot me-1"></i> ติดต่ออู่ &amp; แผนที่</a>
      </nav>
    </div>
  </header>

  <div class="login-main-area">
    <div class="login-box">
      <div class="logo-wrap">
        <div class="logo-svg-badge">
          <svg width="44" height="44" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 36L20 22H44L50 36H14Z" stroke="#38BDF8" stroke-width="3" fill="rgba(56,189,248,0.15)"/>
            <rect x="10" y="35" width="44" height="11" rx="4" fill="#38BDF8"/>
            <circle cx="20" cy="46" r="5" fill="#090D16" stroke="#E2E8F0" stroke-width="3"/>
            <circle cx="44" cy="46" r="5" fill="#090D16" stroke="#E2E8F0" stroke-width="3"/>
            <path d="M8 54H56" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>
            <path d="M18 54V59M46 54V59" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <h1 class="app-title">เข้าสู่ระบบพนักงานอู่</h1>
        <div class="app-subtitle">อู่สมาร์ทการาจ (SmartGarage Auto Service)</div>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger bg-danger bg-opacity-25 text-light border-danger d-flex align-items-center gap-2 py-2.5 px-3 mb-3" role="alert" style="border-radius: 12px; font-size: 0.94rem;">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success bg-success bg-opacity-25 text-light border-success d-flex align-items-center gap-2 py-2.5 px-3 mb-3" role="alert" style="border-radius: 12px; font-size: 0.94rem;">
          <i class="fa-solid fa-circle-check"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" autocomplete="on">
        <div class="mb-3">
          <label for="username" class="field-label">ชื่อผู้ใช้งาน</label>
          <div class="input-group-friendly">
            <i class="fa-solid fa-user input-icon-left"></i>
            <input type="text" class="friendly-input" id="username" name="username" value="<%= typeof username !== 'undefined' && username ? username : '' %>" placeholder="กรอกชื่อผู้ใช้งาน" required autofocus>
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="password" class="field-label mb-0">รหัสผ่าน</label>
            <a href="/auth/forgot-password" class="forgot-link">
              <i class="fa-solid fa-key me-1"></i>ลืมรหัสผ่าน?
            </a>
          </div>
          <div class="input-group-friendly">
            <i class="fa-solid fa-lock input-icon-left"></i>
            <input type="password" class="friendly-input" id="password" name="password" placeholder="กรอกรหัสผ่าน" required>
            <button type="button" class="toggle-pw-btn" id="togglePwBtn" title="กดเพื่อดูหรือซ่อนรหัสผ่าน">
              <i class="fa-solid fa-eye" id="togglePwIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-login-main">
          <i class="fa-solid fa-right-to-bracket"></i>
          <span>เข้าสู่ระบบจัดการอู่</span>
        </button>
      </form>

      <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
        <a href="/" class="text-decoration-none fw-bold text-info" style="font-size: 0.92rem;">
          <i class="fa-solid fa-arrow-left me-1"></i> กลับไปหน้ารีวิวร้านและข้อมูลติดต่ออู่
        </a>
      </div>
    </div>
  </div>

  <script>
    const pwInput = document.getElementById('password');
    const toggleBtn = document.getElementById('togglePwBtn');
    const toggleIcon = document.getElementById('togglePwIcon');
    if (toggleBtn && pwInput) {
      toggleBtn.addEventListener('click', function() {
        const isPw = pwInput.getAttribute('type') === 'password';
        pwInput.setAttribute('type', isPw ? 'text' : 'password');
        toggleIcon.className = isPw ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
      });
    }
  </script>
</body>
</html>
