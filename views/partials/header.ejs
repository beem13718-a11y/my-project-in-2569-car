<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | สมาร์ทการาจ (SmartGarage)' : 'สมาร์ทการาจ (SmartGarage) - ระบบจัดการอู่ซ่อมรถยนต์' %></title>
  
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  
  <link rel="stylesheet" href="/css/style.css">

  
  <script>
    (function() {
      const savedTheme = localStorage.getItem('garageflow_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>
  
  <div class="app-container">
    
    <%- include('sidebar') %>

    
    <div class="main-content">
      
      
      <header class="top-header">
        <div class="d-flex align-items-center gap-3">
          <button class="sidebar-toggle" id="sidebarToggleBtn">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div class="h5 m-0 text-main font-weight-bold d-flex align-items-center gap-2">
            <i class="fa-solid fa-shield-halved text-info" style="font-size: 1.3rem;"></i>
            <span style="background: linear-gradient(135deg, #38bdf8, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; letter-spacing: 0.5px;">SmartGarage</span>
          </div>
        </div>

        
        <nav class="top-nav d-none d-lg-flex align-items-center gap-2 mx-auto">
          <a href="/dashboard" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
            <i class="fa-solid fa-chart-line text-primary"></i> แผงควบคุม
          </a>
          <a href="/customers" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'active' : '' %>">
            <i class="fa-solid fa-users text-info"></i> ลูกค้า
          </a>
          <a href="/vehicles" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'vehicles' ? 'active' : '' %>">
            <i class="fa-solid fa-car text-success"></i> รถยนต์
          </a>
          <a href="/repairs" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'repairs' ? 'active' : '' %>">
            <i class="fa-solid fa-screwdriver-wrench text-warning"></i> งานซ่อม
          </a>
          <a href="/inventory" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'inventory' ? 'active' : '' %>">
            <i class="fa-solid fa-boxes-stacked text-info"></i> คลังอะไหล่
          </a>
          <a href="/finances" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'finances' ? 'active' : '' %>">
            <i class="fa-solid fa-wallet text-success"></i> การเงิน
          </a>
          <a href="/attendance" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'attendance' ? 'active' : '' %>">
            <i class="fa-solid fa-clipboard-user text-primary"></i> เช็คชื่อ
          </a>
          <% if (typeof user !== 'undefined' && user && user.role === 'owner') { %>
            <a href="/mechanics" class="top-nav-link <%= typeof activePage !== 'undefined' && activePage === 'mechanics' ? 'active' : '' %>">
              <i class="fa-solid fa-user-gear text-info"></i> ช่างซ่อม
            </a>
          <% } %>
        </nav>
        
        <div class="header-right d-flex align-items-center gap-2">
          
          <button type="button" class="btn btn-glass-secondary py-1 px-2.5 d-flex align-items-center gap-1.5 shadow-sm" id="themeToggleBtn" title="สลับโหมดมืด / สว่าง (Dark / Light Theme)" style="border-radius: 8px; font-size: 0.82rem; height: 34px;">
            <i class="fa-solid fa-moon text-warning" id="themeIcon"></i>
            <span class="d-none d-sm-inline small" id="themeLabel">โหมดมืด</span>
          </button>

          
          <div class="notifications-dropdown">
            <button class="notifications-trigger" title="ระบบแจ้งเตือน">
              <i class="fa-solid fa-bell"></i>
              <span class="notification-badge"></span>
            </button>
          </div>
          
          
          <% if (typeof user !== 'undefined' && user) { 
            let cleanFullname = (user.fullname || '').replace(/\s*\([^)]*\)/g, '').trim();
            let roleLabel = 'ผู้ใช้งาน';
            let roleLetter = 'ผ';
            let roleBg = 'linear-gradient(135deg, #00E5FF, #0055FF)';
            let badgeClass = 'bg-secondary bg-opacity-25 text-light border border-secondary';

            if (user.role === 'owner') {
              roleLabel = 'เจ้าของอู่ / ผู้ดูแลระบบ';
              roleLetter = 'จ';
              roleBg = 'linear-gradient(135deg, #FF3D00, #FFE600)';
              badgeClass = 'bg-warning bg-opacity-25 text-warning border border-warning';
            } else if (user.role === 'mechanic') {
              roleLabel = 'ช่างซ่อมบำรุง';
              roleLetter = 'ช';
              roleBg = 'linear-gradient(135deg, #00E5FF, #0055FF)';
              badgeClass = 'bg-info bg-opacity-25 text-info border border-info';
            } else if (user.role === 'receptionist') {
              roleLabel = 'พนักงานต้อนรับ/การเงิน';
              roleLetter = 'ต';
              roleBg = 'linear-gradient(135deg, #FF9100, #FFEA00)';
              badgeClass = 'bg-warning bg-opacity-25 text-warning border border-warning';
            } else if (user.role === 'inventory') {
              roleLabel = 'เจ้าหน้าที่คลังอะไหล่';
              roleLetter = 'ค';
              roleBg = 'linear-gradient(135deg, #00E676, #00B0FF)';
              badgeClass = 'bg-success bg-opacity-25 text-success border border-success';
            }
          %>
            <div class="dropdown">
              <button class="btn btn-glass-primary dropdown-toggle d-flex align-items-center gap-2 py-1.5" 
                      style="border-color: <%= user.role === 'owner' ? 'rgba(255, 107, 0, 0.35)' : 'rgba(0, 229, 255, 0.35)' %>;
                             box-shadow: 0 0 10px <%= user.role === 'owner' ? 'rgba(255, 107, 0, 0.05)' : 'rgba(0, 229, 255, 0.05)' %>;"
                      type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar d-flex align-items-center justify-content-center" 
                     style="width: 26px; height: 26px; font-size: 0.75rem; border-radius: 6px; box-shadow: none; 
                            background: <%= roleBg %>; 
                            color: #fff; font-weight: bold; text-shadow: 0 1px 2px rgba(0,0,0,0.3);">
                  <%= roleLetter %>
                </div>
                <span class="small fw-semibold text-light"><%= cleanFullname %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end text-light" aria-labelledby="userMenuDropdown" style="background: rgba(14, 16, 22, 0.95); border: 1px solid var(--card-border); backdrop-filter: var(--glass-blur); min-width: 210px;">
                <li class="px-3 py-2 border-bottom border-secondary border-opacity-25 mb-1">
                  <div class="small text-muted" style="font-size: 0.75rem;">ผู้ปฏิบัติงาน:</div>
                  <div class="fw-bold text-light" style="font-size: 0.88rem;"><%= cleanFullname %></div>
                  <span class="badge mt-1 <%= badgeClass %>" style="font-size: 0.72rem; font-weight: 600; padding: 3px 8px;">
                    <%= roleLabel %>
                  </span>
                </li>
                <% if (user.role === 'owner') { %>
                  <li>
                    <a class="dropdown-item text-light py-2 small" href="/settings">
                      <i class="fa-solid fa-gears me-2 text-muted" style="font-size: 0.85rem;"></i>ตั้งค่าระบบ
                    </a>
                  </li>
                <% } %>
                <li>
                  <a class="dropdown-item text-danger py-2 small" href="/auth/logout">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>ออกจากระบบ
                  </a>
                </li>
              </ul>
            </div>
          <% } else { %>
            <a href="/auth/login" class="btn btn-sm btn-glass-primary">
              <i class="fa-solid fa-right-to-bracket me-1"></i> เข้าสู่ระบบ
            </a>
          <% } %>
        </div>
      </header>

      
      <main class="content-body">
